    <model name="stem_end_0"><static>true</static><pose>-0.3550 -1.7303 .5 0 0 0.00138</pose><link name="wall"><collision name="collision"><geometry><box><size>0.7000 0.1600 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.7000 0.1600 1</size></box></geometry><material><ambient>.62 .46 .27 1</ambient><diffuse>.62 .46 .27 1</diffuse></material></visual></link></model>
    <model name="stem_end_1"><static>true</static><pose>0.3550 -1.7392 .5 0 0 -0.00584</pose><link name="wall"><collision name="collision"><geometry><box><size>0.7000 0.1600 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.7000 0.1600 1</size></box></geometry><material><ambient>.62 .46 .27 1</ambient><diffuse>.62 .46 .27 1</diffuse></material></visual></link></model>
  </world>
