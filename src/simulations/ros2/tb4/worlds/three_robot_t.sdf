<?xml version="1.0"?>
<!-- MARCO three-robot T-junction for Ignition Gazebo (TurtleBot 4). Walls identical to three_robot_t.world. -->
<sdf version="1.8">
  <world name="three_robot_t">
    <physics name="1ms" type="ignored"><max_step_size>0.003</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-contact-system" name="ignition::gazebo::systems::Contact"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.7 0.8 0.9 1</background><grid>false</grid></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction><cast_shadows>false</cast_shadows></light>
    <model name="floor"><static>true</static><pose>0 -1 -0.05 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>9 7 0.1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>9 7 0.1</size></box></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
    </link></model>
    <model name="north_0"><static>true</static><pose>-1.2450 0.3300 .5 0 0 0.00365</pose><link name="wall"><collision name="collision"><geometry><box><size>0.8200 0.1600 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8200 0.1600 1</size></box></geometry><material><ambient>.62 .46 .27 1</ambient><diffuse>.62 .46 .27 1</diffuse></material></visual></link></model>
    <model name="north_1"><static>true</static><pose>-0.4150 0.3284 .5 0 0 -0.01088</pose><link name="wall"><collision name="collision"><geometry><box><size>0.8200 0.1600 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8200 0.1600 1</size></box></geometry><material><ambient>.62 .46 .27 1</ambient><diffuse>.62 .46 .27 1</diffuse></material></visual></link></model>
    <model name="north_2"><static>true</static><pose>0.4150 0.3273 .5 0 0 -0.01212</pose><link name="wall"><collision name="collision"><geometry><box><size>0.8200 0.1600 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8200 0.1600 1</size></box></geometry><material><ambient>.62 .46 .27 1</ambient><diffuse>.62 .46 .27 1</diffuse></material></visual></link></model>
    <model name="north_3"><static>true</static><pose>1.2450 0.3304 .5 0 0 0.01637</pose><link name="wall"><collision name="collision"><geometry><box><size>0.8200 0.1600 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8200 0.1600 1</size></box></geometry><material><ambient>.62 .46 .27 1</ambient><diffuse>.62 .46 .27 1</diffuse></material></visual></link></model>
    <model name="west_0"><static>true</static><pose>-1.5770 -0.0000 .5 0 0 1.56322</pose><link name="wall"><collision name="collision"><geometry><box><size>0.4900 0.1600 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4900 0.1600 1</size></box></geometry><material><ambient>.62 .46 .27 1</ambient><diffuse>.62 .46 .27 1</diffuse></material></visual></link></model>
    <model name="east_0"><static>true</static><pose>1.5771 0.0000 .5 0 0 1.57516</pose><link name="wall"><collision name="collision"><geometry><box><size>0.4900 0.1600 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4900 0.1600 1</size></box></geometry><material><ambient>.62 .46 .27 1</ambient><diffuse>.62 .46 .27 1</diffuse></material></visual></link></model>
