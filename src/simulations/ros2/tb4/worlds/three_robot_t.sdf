    <model name="stem_left_1"><static>true</static><pose>-0.6376 -1.4200 .5 0 0 -1.56748</pose><link name="wall"><collision name="collision"><geometry><box><size>0.7700 0.1600 1</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.7700 0.1600 1</size></box></geometry><material><ambient>.62 .46 .27 1</ambient><diffuse>.62 .46 .27 1</diffuse></material></visual></link></model>
